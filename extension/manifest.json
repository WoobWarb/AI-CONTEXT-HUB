{
  "manifest_version": 3,
  "name": "AI Context Hub Bridge",
  "version": "1.0.3",
  "description": "เชื่อมต่อ ChatGPT, Claude, Gemini, DeepSeek เข้ากับไฟล์ในเครื่องผ่าน AI Context Hub",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://*.chatgpt.com/*",
        "*://claude.ai/*",
        "*://*.claude.ai/*",
        "*://chat.deepseek.com/*",
        "*://*.deepseek.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "host_permissions": [
    "http://localhost:4001/*",
    "http://127.0.0.1:4001/*"
  ]
}
